DISCORD_TOKEN=your_bot_token_here
ERLC_SERVER_KEY=
GITHUB_TOKEN=
GITHUB_REPO=hamburger445/VSRP-Bot

# Bot database (GitHub JSON). Keep GITHUB_TOKEN set.
BOT_DATABASE=github
GITHUB_DB_PATH=data/cad/db.json
GITHUB_DB_BRANCH=cad-data

# Unused when BOT_DATABASE=github. Leave blank unless you switch to Postgres.
DATABASE_URL=

# WispByte: poll GitHub and reload on a new main commit (on by default in /home/container)
# DEPLOY_WATCH=1
# DEPLOY_POLL_SECONDS=20

# Paper forms website (citations / warrants). Allocate a public port on WispByte.
# FORM_PORT defaults to SERVER_PORT (often the panel allocation).
# PUBLIC_FORM_URL must be the URL officers can open (http://IP:PORT). Without it, Discord uses in-app forms.
# FORM_PORT=8080
# PUBLIC_FORM_URL=http://127.0.0.1:8080
# Optional: FORM_SECRET=long-random-string  (defaults to hashing the Discord token)

APP_ENV=development
LOG_LEVEL=INFO
