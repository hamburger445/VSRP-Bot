DISCORD_TOKEN=your_bot_token_here
ERLC_SERVER_KEY=
GITHUB_TOKEN=
GITHUB_REPO=hamburger445/VSRP-Bot

# Bot database (GitHub JSON). Keep GITHUB_TOKEN set.
BOT_DATABASE=github
GITHUB_DB_PATH=data/cad/db.json
GITHUB_DB_BRANCH=cad-data

# Unused when BOT_DATABASE=github. Leave blank unless you switch to Postgres.
DATABASE_URL=

# WispByte: poll GitHub and reload on a new main commit (on by default in /home/container)
# DEPLOY_WATCH=1
# DEPLOY_POLL_SECONDS=20

# Document editor (Render HTTPS). Same value on WispByte and Render. IPs and http:// are ignored.
# PUBLIC_FORM_URL=https://vsrp-forms.onrender.com
# FORM_SECRET=long-random-string
# On Render also set DISCORD_TOKEN, GITHUB_TOKEN, BOT_DATABASE=github, FORM_SECRET, PUBLIC_FORM_URL

APP_ENV=development
LOG_LEVEL=INFO
