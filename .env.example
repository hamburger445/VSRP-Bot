DISCORD_TOKEN=your_bot_token_here
ERLC_SERVER_KEY=
GITHUB_TOKEN=
GITHUB_REPO=hamburger445/VSRP-Bot

# Bot database (GitHub JSON). Keep GITHUB_TOKEN set.
BOT_DATABASE=github
GITHUB_DB_PATH=data/cad/db.json
GITHUB_DB_BRANCH=cad-data

# Unused when BOT_DATABASE=github. Leave blank unless you switch to Postgres.
DATABASE_URL=

# WispByte: poll GitHub and reload on a new main commit (on by default when panel-start.sh wrote .deploy-sha)
# DEPLOY_WATCH=1
# DEPLOY_POLL_SECONDS=60

APP_ENV=development
LOG_LEVEL=INFO
